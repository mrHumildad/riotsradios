{
  "name": "riotsradios",
  "version": "1.5.0",
  "description": "Free Community Radio Player",
  "homepage": "https://mrhumildad.github.io/riotsradios/",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run validate:stations && npm run catalog:check",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "validate:epg": "node scripts/validate-epgs.js",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "catalog:sync": "node scripts/sync-catalog.mjs --write",
    "validate:stations": "node scripts/validate-stations.js",
    "test": "node --test tests/*.test.mjs",
    "build:android": "APP_BUILD=1 vite build --base=./ --outDir dist-android",
    "prebuild:android": "npm run validate:stations && npm run catalog:check",
    "cleartext:config": "node scripts/generate-cleartext-config.mjs",
    "assets:android": "python3 scripts/generate-android-assets.py",
    "assets:store": "python3 scripts/generate-store-assets.py",
    "assets:store:check": "python3 scripts/generate-store-assets.py --check",
    "assets:android:check": "python3 scripts/generate-android-assets.py --check",
    "export:bands": "node scripts/export-spectrum-bands.mjs",
    "android:sync": "npm run cleartext:config && npm run export:bands && npm run build:android && cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:bundle": "npm run android:sync && cd android && ./gradlew bundleRelease assembleRelease",
    "android:export": "node scripts/export-android.mjs",
    "release:android": "node scripts/release-android.mjs",
    "android:icons": "python3 scripts/generate-android-assets.py",
    "android:open": "cap open android",
    "changeset": "changeset",
    "release": "npx changeset version && npm run deploy && git push --follow-tags && git push origin main"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrHumildad/riotsradios.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/core": "^8.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@changesets/cli": "^2.31.0",
    "@vitejs/plugin-react": "^6.0.2",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.13"
  }
}
