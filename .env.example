[TEMPLATE]
# Optional. Defaults to the published EPG repository.
# VITE_EPG_BASE_URL=https://mrhumildad.github.io/riotsradios-epg

# Optional. Same repository, /catalog/ instead of /EPGs/.
# VITE_CATALOG_BASE_URL=https://mrhumildad.github.io/riotsradios-epg

# Catalog sync is on in production builds and off in development (where the
# editor writes stations.csv). 1 forces it on, 0 turns it off everywhere.
# VITE_CATALOG_SYNC=0
